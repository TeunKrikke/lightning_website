    {
      "id": 6,
      "type": "bargauge",
      "title": "Distance Distribution",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "postgres",
        "uid": "lightning-postgres-datasource"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "lightning-postgres-datasource"
          },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT COUNT(CASE WHEN distance < 5 THEN 1 END) as \"0-5 km (Very Close)\", COUNT(CASE WHEN distance >= 5 AND distance < 15 THEN 1 END) as \"5-15 km (Close)\", COUNT(CASE WHEN distance >= 15 AND distance < 30 THEN 1 END) as \"15-30 km (Moderate)\", COUNT(CASE WHEN distance >= 30 THEN 1 END) as \"30-40 km (Distant)\" FROM strikes WHERE $__timeFilter(timestamp)",
          "refId": "A"
        }
      ],
      "options": {
        "displayMode": "lcd",
        "orientation": "vertical",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "0-5 km (Very Close)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5-15 km (Close)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "15-30 km (Moderate)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "30-40 km (Distant)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
